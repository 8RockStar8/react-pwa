{
  "name": "gagik-cv",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Gagik Aproyan — personal CV as a progressive web app",
  "scripts": {
    "cv": "tsx scripts/generate-cv.ts",
    "predev": "npm run cv",
    "dev": "vite",
    "prebuild": "npm run cv",
    "build": "tsc -b && vite build && cp dist/index.html dist/404.html",
    "preview": "vite preview",
    "ts:check": "tsc -b --noEmit"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@fontsource-variable/archivo": "^5.1.1",
    "@fontsource/atkinson-hyperlegible": "^5.1.1",
    "@mui/icons-material": "^6.4.6",
    "@mui/material": "^6.4.6",
    "jotai": "^2.12.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-error-boundary": "^5.0.0",
    "react-router": "^7.2.0"
  },
  "devDependencies": {
    "@fontsource/archivo": "^5.1.1",
    "@react-pdf/renderer": "^4.1.6",
    "@types/node": "^22.13.8",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "docx": "^9.1.1",
    "tsx": "^4.19.2",
    "typescript": "~5.7.2",
    "vite": "^6.2.0",
    "vite-plugin-pwa": "^0.21.1"
  }
}
